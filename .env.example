# ---------- Backend ----------
# Comma-separated key pool (at least 2), e.g. two Groq keys from console.groq.com/keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name used by every key unless LLM_KEY_MODELS overrides it.
LLM_MODEL=groq/openai/gpt-oss-20b
# Optional: per-key model, aligned with LLM_API_KEYS (e.g. mix providers).
# LLM_KEY_MODELS=groq/openai/gpt-oss-20b,gemini/gemini-flash-latest
LLM_KEY_MODELS=
# SQLite location. Inside Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure header on POST /chat.
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=86400

# ---------- Frontend ----------
# URL the browser uses to reach the backend (docker-compose / runtime config.js).
FRONTEND_API_BASE_URL=http://localhost:8000
# Build-time fallback used by Vercel/Netlify builds.
VITE_API_BASE_URL=http://localhost:8000
